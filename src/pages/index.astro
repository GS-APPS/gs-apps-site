---
import Layout from '../layouts/Layout.astro';
---

<Layout>
	<main class="max-w-5xl mx-auto px-6 py-16">
		
		<!-- Hero Banner Section -->
		<header class="relative mb-16 rounded-3xl overflow-hidden border border-white/10 p-8 md:p-12 bg-cover bg-center" style="background-image: url('/banner.jpg');">
    <!-- Dark Overlay for High Contrast / Readability -->
    <div class="absolute inset-0 bg-slate-950/75 backdrop-blur-sm -z-0"></div>

    <!-- Header Content (Logo + Title) -->
    <div class="relative z-10 flex items-center gap-5 mb-4">
        <img 
            src="/logo.ico" 
            alt="GS-APPS Logo" 
            class="w-16 h-16 md:w-20 md:h-20 rounded-2xl object-cover shadow-2xl border border-white/20" 
        />
    </div>
    
    <!-- Subtitle (Reduced Font Size) -->
    <p class="relative z-10 mt-2 text-sm md:text-base text-slate-300 max-w-2xl">
        Crafting high-performance utilities and digital tools.
    </p>
</header>

		<!-- Bento Grid Container -->
		<section class="grid grid-cols-1 md:grid-cols-2 gap-6">
			
			<!-- Card 1: Finance App -->
			<div class="col-span-1 bg-white/5 border border-white/10 backdrop-blur-md rounded-3xl p-8 flex flex-col justify-between hover:bg-white/10 transition-colors">
				<div>
					<div class="flex justify-between items-start mb-4">
						<span class="inline-block px-3 py-1 bg-blue-500/20 text-blue-300 text-sm font-medium rounded-full">Finance</span>
						<span class="text-xs text-slate-500 font-mono tracking-widest">v5.0</span>
					</div>
					
					<!-- App Icon -->
					<img src="/my-money-pro-logo.png" alt="My Money Pro-S Logo" class="w-16 h-16 rounded-2xl mb-4 shadow-lg object-cover border border-white/10" />
					
					<h2 class="text-3xl font-bold mb-2">My Money Pro-S</h2>
					<p class="text-slate-300">Your personal digital accountant. Take complete control of your money with visual charts and secure cloud sync. No subscriptions, no hidden fees.</p>
				</div>
				<div class="mt-8 flex flex-col gap-3">
					<div class="flex gap-3">
						<a href="https://play.google.com/store/apps/details?id=com.mymoneypros.app.gs" target="_blank" rel="noopener noreferrer" class="flex-1 bg-blue-600 text-white px-4 py-2 rounded-full font-semibold hover:bg-blue-500 transition text-center text-sm">Google Play</a>
						<a href="/privacy/my-money-pro" class="flex-1 px-4 py-2 rounded-full font-semibold border border-white/20 hover:bg-white/10 transition text-center text-sm">Privacy Policy</a>
					</div>
					<div class="flex gap-3">
						<button class="flex-1 bg-black/40 px-4 py-2 rounded-full font-semibold border border-white/10 hover:bg-black/60 transition text-sm text-white">TikTok</button>
						<button class="flex-1 bg-red-600/20 px-4 py-2 rounded-full font-semibold border border-red-500/30 hover:bg-red-600/40 transition text-sm text-red-100">YouTube</button>
					</div>
				</div>
			</div>

			<!-- Card 2: Utility App -->
			<div class="col-span-1 bg-white/5 border border-white/10 backdrop-blur-md rounded-3xl p-8 flex flex-col justify-between hover:bg-white/10 transition-colors">
				<div>
					<div class="flex justify-between items-start mb-4">
						<span class="inline-block px-3 py-1 bg-purple-500/20 text-purple-300 text-sm font-medium rounded-full">Utility</span>
						<span class="text-xs text-slate-500 font-mono tracking-widest">v1.1.4</span>
					</div>
					
					<!-- App Icon -->
					<img src="/qr-on-phone-logo.jpg" alt="QR on Phone Logo" class="w-16 h-16 rounded-2xl mb-4 shadow-lg object-cover border border-white/10" />
					
					<h2 class="text-2xl font-bold mb-2">QR on Phone</h2>
					<p class="text-slate-300 text-sm">The ultimate tool for scanning and managing QR codes effortlessly from your camera or local gallery.</p>
				</div>
				<div class="mt-8 flex flex-col gap-3">
					<div class="flex gap-3">
						<span class="flex-1 text-center px-4 py-2 rounded-full font-semibold border border-white/10 bg-white/5 opacity-50 cursor-not-allowed text-sm">Link Soon</span>
						<a href="/privacy/qr-on-phone" class="flex-1 px-4 py-2 rounded-full font-semibold border border-white/20 hover:bg-white/10 transition text-center text-sm">Privacy Policy</a>
					</div>
					<div class="flex gap-3">
						<button class="flex-1 bg-black/40 px-4 py-2 rounded-full font-semibold border border-white/10 hover:bg-black/60 transition text-sm text-white">TikTok</button>
						<button class="flex-1 bg-red-600/20 px-4 py-2 rounded-full font-semibold border border-red-500/30 hover:bg-red-600/40 transition text-sm text-red-100">YouTube</button>
					</div>
				</div>
			</div>

			<!-- Card 3: Pixel-iT -->
			<div class="col-span-1 bg-white/5 border border-white/10 backdrop-blur-md rounded-3xl p-8 flex flex-col justify-between hover:bg-white/10 transition-colors">
				<div>
					<div class="flex justify-between items-start mb-4">
						<span class="inline-block px-3 py-1 bg-pink-500/20 text-pink-300 text-sm font-medium rounded-full">Media Tool</span>
						<span class="text-xs text-slate-500 font-mono tracking-widest">v1.0.3</span>
					</div>
					
					<!-- App Icon -->
					<img src="/pixel-it-logo.png" alt="Pixel-iT Logo" class="w-16 h-16 rounded-2xl mb-4 shadow-lg object-cover border border-white/10" />
					
					<h2 class="text-3xl font-bold mb-2">Pixel-iT</h2>
					<p class="text-slate-300">Transform photos and videos with retro pixel art, anime styles, and dynamic animations. Completely anonymous workspace driven by a secure, pay-as-you-go digital wallet.</p>
				</div>
				<div class="mt-8 flex flex-col gap-3">
					<div class="flex gap-3">
						<span class="flex-1 px-4 py-2 rounded-full font-semibold border border-white/10 bg-white/5 opacity-50 cursor-not-allowed text-center text-sm">Link Soon</span>
						<a href="/privacy/pixel-it" class="flex-1 px-4 py-2 rounded-full font-semibold border border-white/20 hover:bg-white/10 transition text-center text-sm">Privacy Policy</a>
					</div>
					<div class="flex gap-3">
						<button class="flex-1 bg-black/40 px-4 py-2 rounded-full font-semibold border border-white/10 hover:bg-black/60 transition text-sm text-white">TikTok</button>
						<button class="flex-1 bg-red-600/20 px-4 py-2 rounded-full font-semibold border border-red-500/30 hover:bg-red-600/40 transition text-sm text-red-100">YouTube</button>
					</div>
				</div>
			</div>
		</section>

		<!-- Horizontal Connect Banner -->
		<section class="mt-8 w-full bg-gradient-to-r from-blue-900/20 to-purple-900/20 border border-white/10 backdrop-blur-md rounded-2xl p-6 flex flex-col md:flex-row items-center justify-between gap-6 hover:bg-white/10 transition-colors">
			<div>
				<h3 class="text-xl font-bold mb-1">Connect with GS-APPS</h3>
				<p class="text-slate-400 text-sm">Catch our latest promotional shorts and development updates.</p>
			</div>
			<div class="flex gap-3 w-full md:w-auto">
				<button class="flex-1 md:flex-none bg-black/40 px-8 py-2 rounded-full font-semibold border border-white/10 hover:bg-black/60 transition text-sm text-white">TikTok</button>
				<button class="flex-1 md:flex-none bg-red-600/20 px-8 py-2 rounded-full font-semibold border border-red-500/30 hover:bg-red-600/40 transition text-sm text-red-100">YouTube</button>
			</div>
		</section>

	</main>
</Layout>